{
  "name": "nexssh-workspace",
  "private": true,
  "description": "NexSSH — a fast, minimal SSH client (Tauri + Rust + Svelte)",
  "license": "MIT",
  "workspaces": [
    "ui"
  ],
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "tauri": "tauri",
    "check": "npm run check --workspace ui",
    "test": "npm run test --workspace ui",
    "ui:dev": "npm run dev --workspace ui",
    "ui:build": "npm run build --workspace ui",
    "native:dev": "cargo run -p nexssh-slint",
    "native:build": "cargo build -p nexssh-slint --release",
    "native:check": "cargo check -p nexssh-slint",
    "native:test": "cargo test -p nexssh-slint"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
