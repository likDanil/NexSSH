{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NexSSH",
  "mainBinaryName": "NexSSH",
  "identifier": "io.github.likdanil.nexssh",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev --workspace ui",
    "beforeBuildCommand": "npm run build --workspace ui"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Fast, minimal SSH client",
    "longDescription": "NexSSH is a lightweight open-source SSH client with a calm, terminal-first interface.",
    "publisher": "NexSSH contributors",
    "copyright": "Copyright © NexSSH contributors. MIT License.",
    "license": "MIT",
    "homepage": "https://github.com/likDanil/NexSSH",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh",
        "languages": [
          "English",
          "Russian"
        ],
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBDRjQ1NEM2MTI0RUU4RDAKUldUUTZFNFN4bFQwREExc2xFakpPQVNCY0M0NnB3NjFQMGFab2VrYjNUK3o4Q3hzQjVTSmtwTlUK",
      "endpoints": [
        "https://github.com/likDanil/NexSSH/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
