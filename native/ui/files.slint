import { ScrollView } from "std-widgets.slint";
import { Theme,Icon,IconButton,Action,Input,Toggle } from "controls.slint";
import { I18n } from "i18n.slint";
export struct FileRow {name:string,path:string,folder:bool,size:string,modified:string}
export struct EditRow {id:string,name:string,status:string,conflict:bool}
export component FilesDrawer inherits Rectangle {
    in property <[FileRow]> entries;
    in property <[EditRow]> edits;
    in-out property <string> path;
    in property <bool> loading;
    in property <bool> hidden;
    in property <string> transfer;
    callback action(string,string);
    callback resize(float);
    callback show-hidden(bool);
    property <string> selected;
    background:Theme.bg;
    Rectangle {x:0px;y:0px;width:1px;height:parent.height;background:Theme.border;}
    TouchArea {
        width:5px;mouse-cursor:col-resize;
        property <float> initial-width;
        pointer-event(event)=>{if event.kind==PointerEventKind.down {self.initial-width=root.width/1px;}}
        moved=>{if self.pressed {root.resize(self.initial-width - (self.mouse-x - self.pressed-x)/1px);}}
    }
    Text {x:18px;y:0px;height:42px;text:I18n.tr("files.title");color:Theme.text;font-weight:600;vertical-alignment:center;}
    IconButton {x:parent.width - 105px;y:7px;icon:"refresh";label:I18n.tr("files.refresh");clicked=>{root.action("list",root.path);}}
    IconButton {x:parent.width - 73px;y:7px;icon:"arrowUp";label:I18n.tr("files.up");clicked=>{root.action("up","");}}
    IconButton {x:parent.width - 41px;y:7px;icon:"x";label:I18n.tr("files.close");clicked=>{root.action("close","");}}
    Input {x:12px;y:44px;width:parent.width - 24px;text<=>root.path;placeholder:I18n.tr("files.path");accepted(value)=>{root.action("list",value);}}
    HorizontalLayout {x:12px;y:84px;width:parent.width - 24px;height:30px;spacing:6px;
        Action {text:I18n.tr("files.upload");icon:"upload";clicked=>{root.action("upload","");}}
        Action {text:I18n.tr("files.uploadFolder");clicked=>{root.action("upload-folder","");}}
    }
    HorizontalLayout {x:12px;y:122px;width:parent.width - 24px;height:24px;
        Text {text:I18n.tr("files.showHidden");color:Theme.text-2;vertical-alignment:center;font-size:12px;}
        Toggle {label:I18n.tr("files.showHidden");checked:root.hidden;toggled(value)=>{root.show-hidden(value);}}
    }
    ScrollView {x:8px;y:154px;width:parent.width - 16px;height:parent.height - 174px - (root.edits.length>0 ? 120px:0px) - (root.transfer!="" ? 40px:0px);
        VerticalLayout {spacing:1px;
            if root.loading: Text {text:I18n.tr("files.loading");color:Theme.text-2;height:40px;}
            if !root.loading && root.entries.length==0: Text {text:I18n.tr("files.empty");color:Theme.text-2;height:40px;}
            for entry in root.entries: Rectangle {
                height:34px;border-radius:7px;background:root.selected==entry.path ? Theme.active:area.has-hover ? Theme.hover:transparent;
                accessible-role:button;accessible-label:entry.name;accessible-action-default=>{root.action("open",entry.path);}
                Icon {x:8px;y:10px;width:14px;height:14px;name:entry.folder ? "folder":"file";colorize:Theme.text-2;}
                Text {x:30px;width:parent.width - 158px;height:34px;text:entry.name;color:Theme.text;font-size:12px;vertical-alignment:center;overflow:elide;}
                Text {x:parent.width - 122px;width:60px;height:34px;text:entry.size;color:Theme.text-3;font-size:11px;vertical-alignment:center;horizontal-alignment:right;overflow:elide;}
                area:=TouchArea {clicked=>{root.selected=entry.path;}double-clicked=>{root.action("open",entry.path);}}
                if !entry.folder: IconButton {x:parent.width - 58px;y:4px;icon:"edit";label:I18n.tr("common.edit");clicked=>{root.action("edit",entry.path);}}
                IconButton {x:parent.width - 30px;y:4px;icon:"download";label:I18n.tr("files.download");clicked=>{root.action("download",entry.path);}}
            }
        }
    }
    if root.edits.length>0: ScrollView {
        x:12px;y:parent.height - 130px - (root.transfer!="" ? 40px:0px);width:parent.width - 24px;height:120px;
        VerticalLayout {spacing:5px;
            for edit in root.edits: VerticalLayout {spacing:4px;
                Text {text:edit.name+" · "+edit.status;color:edit.conflict ? Theme.amber:Theme.text-2;font-size:11px;overflow:elide;}
                if edit.conflict: HorizontalLayout {spacing:5px;
                    Action {text:I18n.tr("edit.overwrite");clicked=>{root.action("edit-overwrite",edit.id);}}
                    Action {text:I18n.tr("edit.takeTheirs");clicked=>{root.action("edit-reload",edit.id);}}
                }
            }
        }
    }
    if root.transfer!="": HorizontalLayout {x:12px;y:parent.height - 44px;width:parent.width - 24px;height:32px;
        Text {text:root.transfer;color:Theme.text-2;vertical-alignment:center;overflow:elide;font-size:11px;}
        IconButton {icon:"x";label:I18n.tr("common.cancel");clicked=>{root.action("cancel","");}}
    }
}
