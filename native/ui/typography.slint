// Match the visual emphasis of app.css's 400/500/600 roles with native glyph rendering.
// Keep these separate from the terminal's user-selected font and ANSI bold weights.
export global Typography {
    out property <string> family: "Segoe UI Variable";
    out property <int> regular: 450;
    out property <int> medium: 600;
    out property <int> semibold: 650;
}
